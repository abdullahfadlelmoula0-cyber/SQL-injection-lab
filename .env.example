# AUTHORIZED CYBERSECURITY TRAINING LAB
# Copy this file to .env.local and adjust as needed.
# No real secrets belong in this project — the database is a fake, seeded demo DB.

# Path to the local SQLite demo database file (relative to project root).
# This DB is fully synthetic and reset-able via `npm run seed`.
DATABASE_FILE=./database/lab.db

# Set to "true" to expose the /admin/logs lab dashboard without a login gate.
# In a real deployment you would put this behind proper auth — for the lab it's
# intentionally simple so instructors can see activity easily.
ADMIN_LOGS_OPEN=true

# Optional: a shared "instructor" passphrase to view /admin/logs if
# ADMIN_LOGS_OPEN is "false". Not used for anything security-critical.
ADMIN_LOGS_PASSPHRASE=change-me-for-your-class
